#!/bin/bash
# 凭证闸门：阻止小米云 token 等机密进入提交。
# 由来：2026-07-30 一次 `git add -f assets/` 把 params-backup-SECRETS/token.toml
# 强制加进了暂存区（-f 会覆盖 .gitignore）。当场发现并撤掉，但必须自动化防呆。
set -u
bad=0

# ① 路径黑名单
if git diff --cached --name-only | grep -qE "params-backup-SECRETS|/token\.toml$|\.pem$|id_rsa$"; then
  echo "❌ 提交被拦截：暂存区含机密路径"
  git diff --cached --name-only | grep -E "params-backup-SECRETS|/token\.toml$|\.pem$|id_rsa$" | sed 's/^/   /'
  bad=1
fi

# ② 内容特征（小米云 token 的实测前缀 + 通用密钥特征）
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  [ -f "$f" ] || continue
  # 二进制跳过；钩子自身跳过（它必须包含这些检测模式，否则自己拦自己）
  case "$f" in
    *.bin|*.engine|*.img) continue ;;
    .githooks/pre-commit) continue ;;
  esac
  if grep -qE 'token_access|token_fresh|"V3_P_|"R3_txb|BEGIN (RSA|OPENSSH) PRIVATE KEY' "$f" 2>/dev/null; then
    echo "❌ 提交被拦截：$f 含疑似凭证"
    bad=1
  fi
done

# ③ 只读性断言：运动桥永远不能长出发送路径
#    用 AST 而非 grep —— 注释里写 "不调用 sendto" 会让 grep 永久误报,
#    那样这条断言就会变成"每次命中然后被人工解释掉"= 等于没有。
BR=dog-scripts/motion/motion_bridge_node.py
if git diff --cached --name-only | grep -q "^$BR$"; then
  if ! python3 dog-scripts/motion/assert_readonly.py "$BR" >/dev/null 2>&1; then
    echo "❌ 提交被拦截：$BR 长出了发送路径或写侧依赖"
    python3 dog-scripts/motion/assert_readonly.py "$BR" | sed 's/^/   /'
    bad=1
  fi
fi

[ "$bad" = "0" ] || { echo "   如确认是误报：git commit --no-verify"; exit 1; }
exit 0
