[Unit]
Description=CyberDog 时钟单调地板(开机推正 / 关机存盘)
DefaultDependencies=no
After=local-fs.target systemd-remount-fs.service
Before=sysinit.target time-set.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/cyberdog-timekeeper --restore
ExecStop=/usr/local/sbin/cyberdog-timekeeper --save

[Install]
WantedBy=sysinit.target
