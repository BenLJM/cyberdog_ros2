[Unit]
Description=OpenVINS monocular VIO (ov_msckf, JP4 chroot on JP5 host)
Documentation=file:/usr/local/bin/ov-vio.sh

# 排序: 栈和相机都先起来。相机是数据源, 没有它 VIO 只会空等。
After=jp5-cyberdog-stack.service d455-camera.service
Wants=d455-camera.service

# 与栈同生共死, 和 d455 同一套语义:
#   PartOf => 对栈的显式 stop/restart 传播到本单元
#   WantedBy(见 [Install]) => 栈起来把本单元也拉起来
# 注意: PartOf 只传播 stop 不传播 start, 所以两个都要有 —— 这是 0726 的血的教训#7。
PartOf=jp5-cyberdog-stack.service

# 起不来就别永动: 15 分钟内最多 5 次
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple

# chroot 的 dev/proc/sys/run bind 必须到位(脚本幂等, 与 d455/stack 共用)
ExecStartPre=/usr/local/bin/jp5-chroot-prep.sh
ExecStart=/usr/local/bin/ov-vio.sh

# lifecycle 节点必须显式 configure+activate, 顺带把 IR 发射器关掉。
# 激活失败 = VIO 是个空进程, 让 unit 响亮地 failed。
ExecStartPost=/usr/local/bin/ov-vio-activate.sh

# 停止时把发射器还给 depth。这样"发射器状态"完全跟随 VIO 生命周期,
# `systemctl stop ov-vio` 就能把深度质量原样还回去, 不留暗状态。
ExecStopPost=/usr/local/bin/ov-vio-emitter.sh 1

# 🔴 必须是 always, 不能是 on-failure。
# 2026-07-28 实测：VIO 起来并 activate 成功之后, 约 2 分钟自己退出了
# (journal: `ov-vio.service: Succeeded.` 紧跟着 ExecStopPost 把发射器还原成 1)。
# 因为退出码落在「成功」区间(0 或 SuccessExitStatus=143), `on-failure` **不会重启**,
# 于是 VIO 就永远躺平了 —— 而外部看到的现象只是「emitter_enabled 莫名其妙变回 1」,
# 极难联想到是 VIO 没了。
# 根因未查清(栈的日志把现场淹了), 但不论什么原因, 一个纯感知的常驻服务
# 都不该「安静地消失且永不回来」。always + 下面的限流是正确的兜底。
Restart=always
RestartSec=20
# 78 = 缺文件/缺包, 重试无意义 -> 躺平等人
RestartPreventExitStatus=78
# 143 = 128+SIGTERM, 正常停机(含经 PartOf 传播的栈 stop)就是这么退的,
# 不声明的话每次正常停机都会落 failed 态, 误导哨兵和人。
# 注意: 有了 Restart=always, 这一条只影响「落不落 failed 态」, 不再影响「重不重启」——
# `systemctl stop` 和 PartOf 传播的 stop 本来就不会被 Restart=always 拉起来。
SuccessExitStatus=143

KillMode=control-group
TimeoutStopSec=25

# VIO 是纯感知, 永远让路给运动栈和相机取流。
Nice=10
CPUWeight=30

[Install]
# 装在栈的 .wants 下: 栈起 -> VIO 起; 栈停 -> PartOf 把 VIO 带走
WantedBy=jp5-cyberdog-stack.service
