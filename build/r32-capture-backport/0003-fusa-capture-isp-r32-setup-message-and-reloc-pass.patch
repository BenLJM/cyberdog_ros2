+#if IS_ENABLED(CONFIG_TEGRA_CAPTURE_R32_ABI)
 /**
+ * @brief r32 per-frame memory model for ISP: in-place relocation.
+ *
+ * Mirror of the VI-side relocation pass (see capture-vi-channel.c), driven by
+ * the r32 struct capture_isp_reloc list that userspace supplies with every
+ * ISP process/program request.  r32 firmware reads IOVAs out of the process
+ * descriptor itself; it knows nothing about r35's side memoryinfo array.
+ *
+ * The one ISP-specific wrinkle: a reloc slot may point at a buffer that lives
+ * *inside* the descriptor ring (ISP pushbuffer 1 and 2 are appended to the
+ * program/process descriptors).  r32 detected that by comparing the embedded
+ * NvRm handle with the ring's own handle and adding the per-descriptor offset.
+ * We keep exactly that rule, using @ref isp_desc_rec.desc_mem recorded at
+ * channel setup.  It is the same arithmetic r35 hardcodes for isp_pb1_mem /
+ * isp_pb2_mem, just generalised over the reloc list.
+ *
+ * As on the VI side, the r32 dma_buf_kmap()/kunmap() page walk is replaced
+ * by the whole-buffer dma_buf_vmap() that capture_common_pin_memory() has
+ * already taken (ctx->requests.va), because dma_buf_kmap() no longer exists
+ * in Linux 5.10.
+ *
+ * @param[in]	chan		ISP channel context
+ * @param[in]	ctx		Descriptor-queue context (process or program)
+ * @param[in]	buffer_index	Descriptor slot
+ * @param[in]	relocs		r32 reloc list for this descriptor
+ * @param[out]	request_unpins	Unpin bookkeeping for this descriptor slot
+ *
+ * @returns	0 (success), neg. errno (failure)
+ */
+static int r32_isp_reloc_request_buffers_locked(
+		struct tegra_isp_channel *chan,
+		struct isp_desc_rec *ctx,
+		uint32_t buffer_index,
+		const struct capture_isp_reloc *relocs,
+		struct capture_common_unpins *request_unpins)
+{
+	struct isp_capture *capture = chan->capture_data;
+	uint32_t *reloc_relatives;
+	uint32_t request_offset = buffer_index * ctx->request_size;
+	size_t buf_size;
+	uint32_t i;
+	int err = 0;
+
+	if (ctx->requests.va == NULL || ctx->requests.buf == NULL) {
+		dev_err(chan->isp_dev, "%s: descriptor ring not mapped\n",
+			__func__);
+		return -EINVAL;
+	}
+
+	if (relocs->num_relocs == 0U ||
+		relocs->num_relocs > MAX_PIN_BUFFER_PER_REQUEST) {
+		dev_err(chan->isp_dev, "%s: bad reloc count %u\n", __func__,
+			relocs->num_relocs);
+		return -EINVAL;
+	}
+
+	buf_size = ctx->requests.buf->size;
+
+	reloc_relatives = kcalloc(relocs->num_relocs, sizeof(uint32_t),
+				GFP_KERNEL);
+	if (unlikely(reloc_relatives == NULL))
+		return -ENOMEM;
+
+	if (copy_from_user(reloc_relatives,
+			(const void __user *)(uintptr_t)relocs->reloc_relatives,
+			(size_t)relocs->num_relocs * sizeof(uint32_t)) != 0U) {
+		dev_err(chan->isp_dev, "%s: failed to copy reloc list\n",
+			__func__);
+		err = -EFAULT;
+		goto out;
+	}
+
+	for (i = 0U; i < relocs->num_relocs; i++) {
+		uint32_t reloc_offset = request_offset + reloc_relatives[i];
+		uint64_t *slot;
+		uint64_t surface_raw;
+		uint32_t target_offset;
+		uint32_t mem;
+		uint64_t target_iova = 0U;
+		uint64_t target_size = 0U;
+
+		if ((reloc_offset % sizeof(uint64_t)) != 0U ||
+			reloc_offset > (buf_size - sizeof(uint64_t))) {
+			dev_err(chan->isp_dev,
+				"%s: reloc %u offset %u out of bounds\n",
+				__func__, i, reloc_offset);
+			err = -EINVAL;
+			goto out;
+		}
+
+		slot = (uint64_t *)((uint8_t *)ctx->requests.va + reloc_offset);
+		surface_raw = READ_ONCE(*slot);
+
+		target_offset = (uint32_t)(surface_raw & 0xFFFFFFFFULL);
+		mem = (uint32_t)(surface_raw >> 32);
+
+		if (mem == 0U) {
+			dev_err(chan->isp_dev,
+				"%s: reloc %u has a NULL mem handle\n",
+				__func__, i);
+			err = -EINVAL;
+			goto out;
+		}
+
+		/* buffer embedded in the descriptor ring itself (pb1/pb2) */
+		if (mem == ctx->desc_mem)
+			target_offset += request_offset;
+
+		err = capture_common_pin_and_get_iova(capture->buffer_ctx, mem,
+				target_offset, &target_iova, &target_size,
+				request_unpins);
+		if (err < 0) {
+			dev_err(chan->isp_dev,
+				"%s: reloc %u pin of handle 0x%x failed\n",
+				__func__, i, mem);
+			goto out;
+		}
+
+		if (target_iova == 0U) {
+			dev_err(chan->isp_dev,
+				"%s: reloc %u resolved to a NULL iova\n",
+				__func__, i);
+			err = -EINVAL;
+			goto out;
+		}
+
+		WRITE_ONCE(*slot, target_iova);
+	}
+
+	/* make the patched descriptor visible to RCE */
+	dma_sync_single_range_for_device(capture->rtcpu_dev,
+			ctx->requests.iova, request_offset,
+			ctx->request_size, DMA_TO_DEVICE);
+
+out:
+	/* unpin cleanup on error is done by isp_capture_request_unpin() */
+	kfree(reloc_relatives);
+	return err;
+}
+#else
+/**
  * Pin/map buffers and save iova boundaries into corresponding
  * memoryinfo struct.
  */
@@ -1645,6 +1844,7 @@
 	/* Unpin cleanup is done in isp_capture_request_unpin() */
 	return err;
 }
+#endif /* CONFIG_TEGRA_CAPTURE_R32_ABI */
 
