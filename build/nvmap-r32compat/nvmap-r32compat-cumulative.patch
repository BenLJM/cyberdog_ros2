+	case NVMAP_IOC_PIN_MULT_R32:
+	case NVMAP_IOC_UNPIN_MULT_R32:
+		pr_warn_once("nvmap: NVMAP_IOC_[UN]PIN_MULT removed in R35 (R32 compat stub). User space must not pin nvmap handles (multiple IOVA spaces).\n");
 		break;
 
 	default:
