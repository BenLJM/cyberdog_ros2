+    .iface = SNDRV_CTL_ELEM_IFACE_MIXER, 
+    .name  = "Master Playback Volume", 
+	.info  = tas5805m_vol_info, 
+	.get   = tas5805m_vol_locked_get,
+	.put   = tas5805m_vol_locked_put, 
+};
