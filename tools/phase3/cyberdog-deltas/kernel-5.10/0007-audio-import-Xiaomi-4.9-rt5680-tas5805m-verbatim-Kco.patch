+
+static int tas5805m_probe(struct device *dev, struct regmap *regmap)
+{
+	struct tas5805m_priv *tas5805m;
+	int ret;
+	
+	tas5805m = devm_kzalloc(dev, sizeof(struct tas5805m_priv), GFP_KERNEL);
+	if (!tas5805m)
+		return -ENOMEM;
+	
+	dev_set_drvdata(dev, tas5805m);
+	tas5805m->regmap = regmap;
+    tas5805m->vol    = 100;
+    
+    mutex_init(&tas5805m->lock);
+
+	mdelay(50);
+
+	ret = regmap_register_patch(regmap, tas5805m_init_sequence0, ARRAY_SIZE(tas5805m_init_sequence0));
+	if (ret != 0)
+	{
+		dev_err(dev, "Failed to initialize TAS5805M sequence0: %d\n",ret);
+		goto err;
+
+	}
+
+	mdelay(5);
+
+	ret = regmap_register_patch(regmap, tas5805m_init_sequence1, ARRAY_SIZE(tas5805m_init_sequence1));
+	if (ret != 0)
+	{
+		dev_err(dev, "Failed to initialize TAS5805M sequence1: %d\n",ret);
+		goto err;
+
+	}
+	mdelay(5);
+	ret = snd_soc_register_codec(dev, 
+	                             &soc_codec_tas5805m,
+			                     &tas5805m_dai, 
+								 1);
+	if (ret != 0) 
+	{
+		dev_err(dev, "Failed to register CODEC: %d\n", ret);
+		goto err;
+	}
+
+	return 0;
+	
+err:
+	return ret;
+
+}
+
+static int tas5805m_enable_pdn(struct device *dev, struct device_node *np)
+{
+	dev_info(dev, "enter tas5805m_enable_pdn\n");
+	/* For CODEC_PA_DVDD_1V8_EN */
+	enable_pdn = of_get_named_gpio(np, "pdn-enable-gpio", 0);
+	if (enable_pdn < 0) {
+		dev_err(dev, "%s: no pa gpio provided!\n", __func__);
+		return -1;
+	} else {
+		dev_info(dev, "%s: pa pdn gpio provided ok, gpio:%d\n", __func__, enable_pdn);
+	}
+	gpio_direction_output(enable_pdn, 1);
+	return 0;
+}
+
+/* For power pin */
+static int tas5805m_enable_power(struct device *dev, struct device_node *np)
+{
+	/* For CODEC_PA_DVDD_1V8_EN */
+	int codec_pa_power_enable_gpio = -1;
+	dev_info(dev, "enter tas5805m_enable_power\n");
+	/* For CODEC_PA_DVDD_1V8_EN */
+	codec_pa_power_enable_gpio = of_get_named_gpio(np, "pa-1v8-enable-gpio", 0);
+	if (codec_pa_power_enable_gpio < 0) {
+		dev_err(dev, "%s: no pa gpio provided!\n", __func__);
+		return -1;
+	} else {
+		dev_info(dev, "%s: pa power gpio provided ok, gpio:%d\n", __func__, codec_pa_power_enable_gpio);
+	}
+	gpio_direction_output(codec_pa_power_enable_gpio, 1);
+	gpio_set_value_cansleep(codec_pa_power_enable_gpio, 1);
+
+	return 0;
+}
+
+static int tas5805m_i2c_probe(struct i2c_client *i2c, const struct i2c_device_id *id)
+{	
+	struct regmap *regmap;
+	struct regmap_config config = tas5805m_regmap;
+
+	struct device_node *np = i2c->dev.of_node;
+	int ret;
+
+	dev_info(&i2c->dev, "enter tas5805m\n");
+	if (np) {
+		ret = tas5805m_enable_power(&i2c->dev, np);
+		if (ret) {
+			dev_err(&i2c->dev, "%s: failed to parse device tree node\n", __func__);
+			return -EIO;
+		}
+	}
+	dev_info(&i2c->dev, "%s: delay 50ms\n", __func__);
+	msleep(50);
+	tas5805m_enable_pdn(&i2c->dev, np);
+
+	mdelay(60);
+
+	regmap = devm_regmap_init_i2c(i2c, &config);
+	if (IS_ERR(regmap))
+		return PTR_ERR(regmap);
+
+	pr_err("TAS5805M: I2C probe\n");
+	return tas5805m_probe(&i2c->dev, regmap);
+}
+
+static int tas5805m_remove(struct device *dev)
+{	
+	gpio_direction_output(enable_pdn, 0);
+	gpio_free(enable_pdn);
+	snd_soc_unregister_codec(dev);
+	
+	return 0;
+}
+
+static int tas5805m_i2c_remove(struct i2c_client *i2c)
+{	
+	tas5805m_remove(&i2c->dev);
+	
+	return 0;
+}
+
+static const struct i2c_device_id tas5805m_i2c_id[] = {
+	{ "tas5805m", },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, tas5805m_i2c_id);
