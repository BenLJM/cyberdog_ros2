From 1f0b48555f8b3795c3f733f9d2596f55bc5c2eff Mon Sep 17 00:00:00 2001
From: CyberDog Port <port@local>
Date: Sun, 19 Jul 2026 11:35:42 +0800
Subject: [PATCH 7/8] audio: import Xiaomi 4.9 rt5680/tas5805m verbatim +
 Kconfig/Makefile/defconfig wiring

Files are the unmodified cyberdog_tegra_kernel (4.9) sources; the component-API
conversion follows as separate commits so the mechanical changes stay reviewable.
---
 arch/arm64/configs/athena_defconfig |    2 +
 sound/soc/codecs/Kconfig            |   10 +
 sound/soc/codecs/Makefile           |    4 +
 sound/soc/codecs/rt5680.c           | 2884 +++++++++++++++++++++++++++
 sound/soc/codecs/rt5680.h           | 2263 +++++++++++++++++++++
 sound/soc/codecs/tas5805m.c         |  598 ++++++
 sound/soc/codecs/tas5805m.h         | 1364 +++++++++++++
 sound/soc/codecs/tas5805m_basic.h   | 1741 ++++++++++++++++
 8 files changed, 8866 insertions(+)
 create mode 100644 sound/soc/codecs/rt5680.c
 create mode 100644 sound/soc/codecs/rt5680.h
 create mode 100644 sound/soc/codecs/tas5805m.c
 create mode 100644 sound/soc/codecs/tas5805m.h
 create mode 100644 sound/soc/codecs/tas5805m_basic.h

diff --git a/arch/arm64/configs/athena_defconfig b/arch/arm64/configs/athena_defconfig
index 8108d6da2..9c46ced4a 100644
--- a/arch/arm64/configs/athena_defconfig
+++ b/arch/arm64/configs/athena_defconfig
@@ -482,3 +482,5 @@ CONFIG_SND_SOC_TEGRA210_AUDIO=m
 CONFIG_SND_SOC_TEGRA_AUDIO_GRAPH_CARD=m
 CONFIG_SND_SIMPLE_CARD=m
 CONFIG_SND_AUDIO_GRAPH_CARD=m
+CONFIG_SND_SOC_RT5680=m
+CONFIG_SND_SOC_TAS5805M=m
diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
index b41b4d65a..d5babb031 100644
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -1174,6 +1174,11 @@ config SND_SOC_RT5677
 	select REGMAP_I2C
 	select REGMAP_IRQ
 
+config SND_SOC_RT5680
+	tristate "Realtek RT5680 CODEC (CyberDog)"
+	depends on I2C
+	select REGMAP_I2C
+
 config SND_SOC_RT5677_SPI
 	tristate
 	default SND_SOC_RT5677 && SPI
@@ -1320,6 +1325,11 @@ config SND_SOC_TAS5086
 	tristate "Texas Instruments TAS5086 speaker amplifier"
 	depends on I2C
 
+config SND_SOC_TAS5805M
+	tristate "Texas Instruments TAS5805M amplifier (CyberDog)"
+	depends on I2C
+	select REGMAP_I2C
+
 config SND_SOC_TAS571X
 	tristate "Texas Instruments TAS571x power amplifiers"
 	depends on I2C
