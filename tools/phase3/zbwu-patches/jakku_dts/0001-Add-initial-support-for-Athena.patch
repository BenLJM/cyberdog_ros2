 .../tegra194-fixed-regulator-p2151-0000.dtsi  | 281 ++++++++++++
 common/tegra194-p2151-0000.dtsi               | 427 ++++++++++++++++++
 common/tegra194-p2151-disp.dtsi               |  61 +++
 tegra194-p3668-0001-p2151-0000.dts            |  26 ++
 5 files changed, 799 insertions(+), 1 deletion(-)
