+/ {
+	tegra-capture-vi {
+		num-channels = <3>;
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			port@0 {
+				reg = <0>;
+				p2151_vi_in0: endpoint {
+					port-index = <0>;
+					bus-width = <1>;
+					remote-endpoint = <&p2151_csi_out0>;
+				};
+			};
+			port@1 {
+				reg = <1>;
+				p2151_vi_in1: endpoint {
+					port-index = <1>;
+					bus-width = <1>;
+					remote-endpoint = <&p2151_csi_out1>;
+				};
+			};
+			port@2 {
+				reg = <2>;
+				p2151_vi_in2: endpoint {
+					port-index = <4>;
+					bus-width = <4>;
+					remote-endpoint = <&p2151_csi_out2>;
+				};
+			};
+		};
+	};
+
+	host1x@13e00000 {
+		nvcsi@15a00000 {
+			num-channels = <3>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			channel@0 {
+				reg = <0>;
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+					port@0 {
+						reg = <0>;
