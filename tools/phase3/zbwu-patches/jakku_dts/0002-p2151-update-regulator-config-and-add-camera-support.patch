+					};
+					port@1 {
+						reg = <1>;
+						p2151_csi_out0: endpoint@1 {
+							remote-endpoint = <&p2151_vi_in0>;
+						};
+					};
+				};
+			};
+			channel@1 {
+				reg = <1>;
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+					port@0 {
+						reg = <0>;
+						p2151_csi_in1: endpoint@2 {
+							port-index = <1>;
+							bus-width = <1>;
+							remote-endpoint = <&p2151_ov7251_out1>;
